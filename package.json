{
  "name": "ymir-image-processing",
  "version": "1.0.0",
  "author": "Carl Alexander",
  "description": "Ymir Lambda@Edge function used to with CloudFront to make an image processing proxy",
  "license": "MIT",
  "main": "index.js",
  "dependencies": {
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1172.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.1"
  },
  "scripts": {
    "build-zip": "scripts/build-zip.sh",
    "calculate-sha": "openssl dgst -sha256 -binary ymir-image-processing.zip | openssl enc -base64",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --fix .",
    "lint:check": "eslint .",
    "test": "jest",
    "test:artifact": "scripts/test-artifact.sh",
    "test:watch": "jest --watch",
    "update": "npm update --os=linux --cpu=x64"
  }
}
